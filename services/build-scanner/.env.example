# Copy to .env and fill with values from the private Supabase + Creator deployments.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
GAMEON_CREATOR_BASE_URL=https://creator.YOUR_DOMAIN
GAMEON_SCANNER_WEBHOOK_SECRET=USE_THE_SAME_LONG_RANDOM_SECRET_AS_CREATOR

# Internal Docker network; do not expose the ClamAV port to the public internet.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Conservative initial beta settings.
SCANNER_POLL_MS=5000
SCANNER_BATCH_SIZE=2
SCANNER_STALE_AFTER_MS=900000
CLAMAV_TIMEOUT_MS=180000
OBJECT_FETCH_TIMEOUT_MS=120000
SUPABASE_REQUEST_TIMEOUT_MS=30000
