NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SERVER ONLY — use the Supabase secret key (sb_secret_...) or legacy service_role key.
# Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
# Comma-separated Supabase Auth user UUIDs authorised for /admin moderation.
GAMEON_ADMIN_USER_IDS=YOUR_ADMIN_AUTH_USER_UUID

# Keep uploads disabled until the private scanner and ClamAV are deployed and tested.
GAMEON_SCANNER_ENABLED=false
# Server-only secret used by your trusted malware-scanner service callback.
GAMEON_SCANNER_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Must not exceed the Supabase Storage global/bucket file-size limit. Default is 50 MiB.
GAMEON_MAX_BUILD_BYTES=52428800

# SERVER ONLY — shared Paystack secret used by the authorised refund-review endpoint.
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Must match the Store configuration; refunds are disabled by default.
GAMEON_PAYMENTS_ENABLED=false
GAMEON_PAYMENTS_MODE=test
GAMEON_LIVE_PAYMENTS_APPROVED=false
