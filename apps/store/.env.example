NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# SERVER ONLY — use the Supabase secret key (sb_secret_...) or legacy service_role key.
# Keep this server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT

# SERVER ONLY — Paystack secret key. Start with a Paystack test secret (sk_test_...).
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Payments are disabled unless explicitly enabled after staging tests.
GAMEON_PAYMENTS_ENABLED=false
GAMEON_PAYMENTS_MODE=test
# Required only when intentionally moving to live funds after written approval.
GAMEON_LIVE_PAYMENTS_APPROVED=false
# Proposed launch commission in basis points: 1000 = 10%. Legal/business approval required.
GAMEON_PLATFORM_FEE_BPS=1000
# Public Store base URL used for checkout return redirects.
GAMEON_STORE_URL=http://localhost:3000
