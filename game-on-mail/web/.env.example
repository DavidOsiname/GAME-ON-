# Local-only setup. Set DATABASE_URL to match the credentials in database/.env.
DATABASE_URL=postgresql://gameon_mail_dev:replace-with-a-long-random-local-only-password@127.0.0.1:5432/gameon_mail
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=true
NEXT_PUBLIC_MAIL_DELIVERY_ENABLED=false

# Email sending is intentionally disabled until the GAME ON mail engine is connected.
MAIL_DELIVERY_ENABLED=false
