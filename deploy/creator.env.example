# Copy to deploy/creator.env. Keep all secrets server-side.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
GAMEON_ADMIN_USER_IDS=YOUR_ADMIN_AUTH_USER_UUID
GAMEON_SCANNER_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
GAMEON_MAX_BUILD_BYTES=52428800
PAYSTACK_SECRET_KEY=
GAMEON_PAYMENTS_ENABLED=false
GAMEON_PAYMENTS_MODE=test
GAMEON_LIVE_PAYMENTS_APPROVED=false
NEXT_PUBLIC_STORE_URL=https://store.example.com
