# Public client configuration only.
# These values are safe to bundle in a mobile app when Supabase RLS is correctly enabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never add a service-role key, database password, Paystack secret, or scanner secret here.
