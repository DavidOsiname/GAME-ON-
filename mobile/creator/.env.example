# Public client configuration only. RLS must remain enabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional Creator server base URL for private build status/upload APIs.
EXPO_PUBLIC_CREATOR_API_URL=https://creator.example.com

